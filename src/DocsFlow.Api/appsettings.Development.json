{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Storage": {
    "S3": {
      "ServiceUrl": "http://localhost:9000",
      "AccessKey": "docsflow",
      "SecretKey": "docsflow-secret",
      "BucketName": "docsflow"
    }
  },
  "Database": {
    "Postgres": {
      "ConnectionString": "Host=localhost;Port=5432;Username=docsflow;Password=docsflow-secret;Database=docsflow"
    }
  },
  "Authentication": {
    "Keycloak": {
      "Authority": "http://localhost:8081/realms/docsflow",
      "ClientId": "docsflow-web",
      "ClientSecret": "docsflow-web-dev-secret",
      "RequireHttps": false
    }
  },
  "Network": {
    "TrustedProxies": {
      "Networks": [
        "172.16.0.0/12"
      ]
    }
  },
  "Llm": {
    "Chat": {
      "Endpoint": "http://localhost:11434/v1",
      "Model": "llama3.1"
    },
    "Embeddings": {
      "Endpoint": "http://localhost:11434/v1",
      "Model": "bge-m3"
    }
  }
}
